<UserControl x:Class="TextureGrade.WpfUI.MainPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" Background="#FFF2F3F5" FontSize="14" UseLayoutRounding="True" d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- 透明棋盘格底，便于看贴图透明区域 -->
        <DrawingBrush x:Key="CheckerBrush" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#FFD8D8D8" Geometry="M0,0 H8 V8 H0 Z"/>
                    <GeometryDrawing Brush="#FFD8D8D8" Geometry="M8,8 H16 V16 H8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 普通按钮（圆角，带 hover/press；Tag="on" 表示选中态的切换按钮） -->
        <Style x:Key="TgButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FF1F1F1F"/>
            <Setter Property="Background" Value="#FFFAFAFA"/>
            <Setter Property="BorderBrush" Value="#FFB9BCC2"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF0F1F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE2E4E8"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="#FFD9E8FB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3B8FE0"/>
                                <Setter Property="Foreground" Value="#FF0B4E8F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewToolButton" TargetType="Button" BasedOn="{StaticResource TgButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <Style x:Key="PreviewToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF687383"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Margin" Value="0,7,8,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FooterToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF687383"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- 主按钮（蓝底，用于「刷新模型」这类主操作） -->
        <Style x:Key="TgPrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="#FF2C8FE6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E7FD6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1769B4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFB9D6F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片标题 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF1F2733"/>
            <Setter Property="Margin" Value="16,14,16,10"/>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDCE0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Camera Raw 风格折叠组：灰底圆角标题条 + ▶/▼
             注意：标题必须包在 ToggleButton 里并把 IsChecked 双向绑到 IsExpanded，
             否则自定义模板下标题「点了没反应」（不能只放 Border）。 -->
        <ControlTemplate x:Key="GroupToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="hdbd" CornerRadius="5" Background="#FFEDEFF2"
                    BorderBrush="#FFD8DCE2" BorderThickness="1" Padding="12,9"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="arrow" Text="▶" FontSize="11" Foreground="#FF5A6472"
                               VerticalAlignment="Center" Margin="0,1,9,0"/>
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="hdbd" Property="Background" Value="#FFE3E7EC"/>
                    <Setter TargetName="hdbd" Property="BorderBrush" Value="#FFC3C9D1"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="arrow" Property="Text" Value="▼"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,7,0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="hdr" Focusable="False" ClickMode="Press"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Template="{StaticResource GroupToggleTemplate}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="body" Padding="2,10,2,2" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="body" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠组标题文字 -->
        <DataTemplate x:Key="GroupHeader">
            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="15" Foreground="#FF1668B8"/>
        </DataTemplate>

        <!-- 材质行：贴图缩略图（无贴图/未生成时回退为漫反射底色）+ ID·名称 + 已修改徽章 -->
        <DataTemplate x:Key="MaterialRowTemplate">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 缩略图容器：Background 用材质 Diffuse 颜色打底，
                     这样透明贴图能透出材质色，缩略图还没生成完时也不是空白格 -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                        Background="{Binding Swatch}" BorderBrush="#FF9AA0A8" BorderThickness="1"
                        VerticalAlignment="Center" SnapsToDevicePixels="True" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="15"
                           VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>

                <Border Grid.Column="2" Background="#FFFFE9A3" BorderBrush="#FFE8CE6A" BorderThickness="1"
                        CornerRadius="4" Padding="9,2" VerticalAlignment="Center"
                        Visibility="{Binding BadgeVisibility}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="12" Foreground="#FF7A5B00"/>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="MaterialItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

    </UserControl.Resources>

    <DockPanel>

        <!-- ================= 底部：操作按钮条 ================= -->
        <Border DockPanel.Dock="Bottom" Background="#FFE9EBEF" BorderBrush="#FFD3D7DD"
            BorderThickness="0,1,0,0" Padding="14,10">
            <WrapPanel>
                <Border BorderBrush="#FFD3D7DD" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,6">
                    <StackPanel>
                        <TextBlock x:Name="TxtSourceTools" Text="模型贴图" Style="{StaticResource FooterToolLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnReRead" Content="重新读取" Style="{StaticResource TgButton}"/>
                            <Button x:Name="BtnRevert" Content="还原" Style="{StaticResource TgButton}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#FFD3D7DD" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,6">
                    <StackPanel>
                        <TextBlock x:Name="TxtOutputTools" Text="应用与保存" Style="{StaticResource FooterToolLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnRefresh" Content="刷新模型" Style="{StaticResource TgPrimaryButton}"/>
                            <Button x:Name="BtnSave" Content="另存为新贴图" Style="{StaticResource TgButton}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock x:Name="TxtHistoryTools" Text="调色历史" Style="{StaticResource FooterToolLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnReset" Content="重置参数" Style="{StaticResource TgButton}"/>
                        <Button x:Name="BtnUndo" Content="撤销" Style="{StaticResource TgButton}"/>
                        <Button x:Name="BtnRedo" Content="重做" Style="{StaticResource TgButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ================= 主区：左预览 / 分隔条 / 右控制 ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- 左：贴图 + UV 预览  -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="12,12,6,12">
                <DockPanel>

                    <TextBlock x:Name="TxtPreviewTitle" DockPanel.Dock="Top" Text="贴图 + UV 预览" Style="{StaticResource CardTitle}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="16,0,16,0">
                        <WrapPanel>
                            <TextBlock x:Name="TxtScopeTitle" Text="调色范围" Margin="0,0,12,5" VerticalAlignment="Center"/>
                            <RadioButton x:Name="ScopeSelection" Content="UV 选区优先" GroupName="TextureScope" Margin="0,0,12,5" VerticalContentAlignment="Center"/>
                            <RadioButton x:Name="ScopeWhole" Content="整张贴图" GroupName="TextureScope" Margin="0,0,0,5" VerticalContentAlignment="Center"/>
                        </WrapPanel>
                        <Border x:Name="ScopeNotice" CornerRadius="3" Padding="8,5" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtScopeNotice" FontSize="12" Foreground="#FF6F603F" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 最底部：操作提示 -->
                    <TextBlock x:Name="ViewHint" DockPanel.Dock="Bottom" Foreground="#FF8A9099"
                     FontSize="13" Margin="16,2,16,14" TextWrapping="Wrap"/>

                    <!-- 倒数第二：UV 坐标读数 -->
                    <TextBlock x:Name="UvReadout" DockPanel.Dock="Bottom" Foreground="#FF5A6472"
                     FontSize="14" Margin="16,8,16,0" Text="(U: —, V: —)"/>

                    <!-- Grouped tools retain their meaning when buttons wrap in a narrow preview. -->
                    <StackPanel x:Name="PreviewTools" DockPanel.Dock="Bottom" Margin="16,10,16,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="TxtViewTools" Text="视图" Style="{StaticResource PreviewToolLabel}"/>
                            <WrapPanel>
                                <Button x:Name="BtnFit" Content="适配" Style="{StaticResource PreviewToolButton}"/>
                                <Button x:Name="BtnActual" Content="100%" Style="{StaticResource PreviewToolButton}"/>
                                <Button x:Name="BtnGrid" Content="网格" Style="{StaticResource PreviewToolButton}"/>
                                <Button x:Name="BtnToggleUV" Content="隐藏 UV" Style="{StaticResource PreviewToolButton}"/>
                                <Button x:Name="BtnCompare" Content="对比原图" Style="{StaticResource PreviewToolButton}"/>
                            </WrapPanel>
                        </DockPanel>
                        <Border BorderBrush="#FFE2E6EB" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="0,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="TxtSelectionTools" Text="选择" Style="{StaticResource PreviewToolLabel}"/>
                                <WrapPanel>
                                    <Button x:Name="BtnSelectMode" Content="选面" Style="{StaticResource PreviewToolButton}"/>
                                    <Button x:Name="BtnMode" Content="平移" Style="{StaticResource PreviewToolButton}"/>
                                    <Button x:Name="BtnIsland" Content="选连通块" Style="{StaticResource PreviewToolButton}"/>
                                    <Button x:Name="BtnInvertSel" Content="反选 UV 选区" Style="{StaticResource PreviewToolButton}"/>
                                    <Button x:Name="BtnClearSel" Content="清空选区" Style="{StaticResource PreviewToolButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="#FFE2E6EB" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="0,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="TxtVertexTools" Text="顶点同步" Style="{StaticResource PreviewToolLabel}"/>
                                <WrapPanel>
                                    <Button x:Name="BtnRecvVerts" Content="从模型接收" Style="{StaticResource PreviewToolButton}"/>
                                    <Button x:Name="BtnSendVerts" Content="发送到模型" Style="{StaticResource PreviewToolButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- 直方图（视图菜单可开关；调色后实时更新，用来判断曝光/色彩分布） -->
                    <Border x:Name="HistogramBox" DockPanel.Dock="Bottom" Margin="16,10,16,0"
                            Background="#FFFBFCFD" BorderBrush="#FFC9CDD4" BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <TextBlock x:Name="TxtHistLabel" DockPanel.Dock="Top" Text="直方图（RGB 叠加）" FontSize="12"
                                       Foreground="#FF7A828C" Margin="8,5,8,0"/>
                            <Canvas x:Name="HistogramCanvas" Height="88" Margin="6,4,6,6"
                                    ClipToBounds="True"/>
                        </DockPanel>
                    </Border>

                    <!-- 预览画布 -->
                    <Border Margin="16,12,16,0" BorderBrush="#FFC9CDD4" BorderThickness="1"
                  Background="#FFEFF1F4" ClipToBounds="True">
                        <Grid x:Name="ViewRoot" Background="#FFEFF1F4" ClipToBounds="True" Focusable="True">
                            <!-- Scene 的所有内容都在「贴图像素坐标系」里，靠 SceneTransform 统一缩放/平移 -->
                            <Canvas x:Name="Scene" IsHitTestVisible="False" RenderTransformOrigin="0,0">
                                <Canvas.RenderTransform>
                                    <MatrixTransform x:Name="SceneTransform"/>
                                </Canvas.RenderTransform>
                                <Rectangle x:Name="CheckerRect" Canvas.Left="0" Canvas.Top="0" Fill="{StaticResource CheckerBrush}"/>
                                <Image x:Name="PreviewImage" Canvas.Left="0" Canvas.Top="0" Stretch="Fill"/>
                                <Canvas x:Name="GridCanvas" Canvas.Left="0" Canvas.Top="0"/>
                                <Canvas x:Name="TextureContextCanvas" Canvas.Left="0" Canvas.Top="0" IsHitTestVisible="False">
                                    <Path x:Name="SharedTexturePath" Stroke="#A0808080"/>
                                </Canvas>
                                <Canvas x:Name="UvCanvas" Canvas.Left="0" Canvas.Top="0"/>
                            </Canvas>

                            <!-- 视图坐标系的橡皮筋选框（不参与命中） -->
                            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True">
                                <Rectangle x:Name="BandRect" Visibility="Collapsed" Fill="#330078D7"
                           Stroke="#FF0078D7" StrokeThickness="1" StrokeDashArray="4,3"/>
                            </Canvas>
                        </Grid>
                    </Border>

                </DockPanel>
            </Border>

            <!-- 左右分隔条（必须是 Grid 的子元素，不能放进 ColumnDefinitions） -->
            <GridSplitter Grid.Column="1" Width="5" Background="#FFD3D7DD"
                    VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    HorizontalAlignment="Center"/>

            <!-- 右：材质列表 + Camera Raw 折叠组 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,12,12,12">
                <DockPanel>

                    <TextBlock x:Name="TxtMaterialTitle" DockPanel.Dock="Top" Text="材质列表" Style="{StaticResource CardTitle}"/>

                    <ListBox x:Name="MaterialList" DockPanel.Dock="Top" MaxHeight="270" Margin="12,0,12,4"
                   FontSize="15"
                   ItemTemplate="{StaticResource MaterialRowTemplate}"
                   ItemContainerStyle="{StaticResource MaterialItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="MaterialList_SelectionChanged"/>

                    <DockPanel DockPanel.Dock="Top" Height="30" Margin="16,14,16,6">
                        <Button x:Name="PaletteSwapCancel" DockPanel.Dock="Right" Visibility="Collapsed" Padding="8,2"/>
                        <TextBlock x:Name="TxtAdjustTitle" Text="调整" FontSize="16" FontWeight="Bold"
                         Foreground="#FF1F2733" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PaletteSwapStatus" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                         Foreground="#FF176C9C" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    </DockPanel>

                    <AdornerDecorator>
                        <ScrollViewer x:Name="AdjustScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel x:Name="RightPanel" Orientation="Vertical" Margin="14,0,14,12"/>
                        </ScrollViewer>
                    </AdornerDecorator>

                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
