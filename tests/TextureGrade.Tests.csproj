<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- PMXEditor 0.2.7.5 and its SlimDX bridge run in a 32-bit process. -->
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PmxEditorDir Condition="'$(PmxEditorDir)' == ''">$(MSBuildProjectDirectory)\..\..\PmxEditor_0275</PmxEditorDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="host\**" />
    <ProjectReference Include="..\PEPlugins-TextureGrade.csproj" />
    <Reference Include="PEPlugin"><HintPath>$(PmxEditorDir)\Lib\PEPlugin\PEPlugin.dll</HintPath></Reference>
  </ItemGroup>
</Project>
